# URL del proyecto Supabase REAL (Project Settings -> API)
SUPABASE_URL=https://mtbnudfydukjnoplzrag.supabase.co

# Publishable key (antes llamada "anon key"). Es segura de usar en un backend
# o incluso en el navegador: el control de acceso real lo hacen las políticas
# RLS de cada tabla en Supabase, no el secreto de esta key.
# NUNCA pegar acá la "secret key" / "service_role key".
SUPABASE_PUBLISHABLE_KEY=tu-publishable-key-aqui

# Puerto donde corre la API
PORT=4000

# Origen permitido para CORS (URL del frontend Vite)
WEB_ORIGIN=http://localhost:5173
